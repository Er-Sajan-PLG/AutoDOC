{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autodoc:context:1",
  "title": "AutoDOC declared context",
  "description": "Schema for the normalised autodoc.toml. Shorthands are normalised before validation (a bare reason string becomes {reason}, a bare fact boolean becomes {value}), so this schema needs no union types. It is validated by the same keyword-subset validator as the catalog, which fails on any keyword it does not implement. The documented spelling is `schema = 1`; `version` is accepted only as an alias that must agree with it. Keys in the three decision tables may be a catalog id or an unambiguous name slug; substitutions are recorded in `resolved_aliases`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "phase",
    "audience",
    "kinds",
    "obligations",
    "facts",
    "not_applicable",
    "satisfied_by",
    "instantiated",
    "severity",
    "phase_declared"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version. Write it as `schema = 1`; `version` is an alias."
    },
    "phase": {
      "type": ["string", "null"]
    },
    "audience": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "reason"],
        "properties": {
          "value": {
            "type": "string",
            "enum": ["true", "false", "unknown"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "not_applicable": {
      "type": "object",
      "description": "Skipped catalog ids. A bare reason string, or a table with an optional owner or review date so an advisory decision is re-checked by someone, sometime.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "review": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        ]
      }
    },
    "satisfied_by": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "instantiated": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "severity": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["error", "warn", "off", "report"]
      }
    },
    "phase_declared": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "When the current phase was declared, so the report can show its age. Written by `autodoc promote`; humans may set it too."
    },
    "resolved_aliases": {
      "type": "object"
    },
    "alias_problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile": {
      "type": ["string", "null"],
      "description": "Which catalog profile decides the core set (CONTROL/metadata/PROFILES.json). A declaration, never an inference; unset means `default`."
    }
  }
}
